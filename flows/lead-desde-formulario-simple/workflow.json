{
  "name": "Kommo - Lead desde formulario (simple)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kommo-form-lead-simple",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook",
      "name": "Webhook formulario",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "kommo-form-lead-simple"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\n\nconst email = (body.email || '').toString().trim().toLowerCase();\n\nlet phone = (body.whatsapp || '').toString();\nphone = phone.replace(/[^+\\d]/g, '');\nif (phone && !phone.startsWith('+')) phone = '+' + phone;\n\nreturn {\n  json: {\n    first_name: (body.nombre || '').toString().trim(),\n    last_name: (body.apellido || '').toString().trim(),\n    email,\n    phone\n  }\n};"
      },
      "id": "node-normalize",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://{{ $env.KOMMO_SUBDOMAIN }}.kommo.com/api/v4/leads/complex",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=[\n  {\n    \"name\": \"Lead web - {{ $json.first_name }} {{ $json.last_name }}\",\n    \"_embedded\": {\n      \"contacts\": [\n        {\n          \"first_name\": \"{{ $json.first_name }}\",\n          \"last_name\": \"{{ $json.last_name }}\",\n          \"custom_fields_values\": [\n            { \"field_code\": \"EMAIL\", \"values\": [{ \"value\": \"{{ $json.email }}\" }] },\n            { \"field_code\": \"PHONE\", \"values\": [{ \"value\": \"{{ $json.phone }}\" }] }\n          ]\n        }\n      ]\n    }\n  }\n]",
        "options": {
          "retry": { "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 2000 }
        }
      },
      "id": "node-complex",
      "name": "POST /leads/complex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CREDENTIAL_ID", "name": "Kommo API" }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ok\": true,\n  \"lead_id\": {{ $json[0].id }},\n  \"contact_id\": {{ $json[0].contact_id }}\n}"
      },
      "id": "node-respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook formulario": { "main": [[{ "node": "Normalizar", "type": "main", "index": 0 }]] },
    "Normalizar": { "main": [[{ "node": "POST /leads/complex", "type": "main", "index": 0 }]] },
    "POST /leads/complex": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "",
  "meta": { "templateCreatedBy": "kommo-n8n wiki" }
}
